# Copy to .env and fill in. Never commit .env.
# These are read by the Node server only; none are VITE_* so none reach the browser bundle.

# Lattice API base, including /api (no trailing slash needed).
LATTICE_API_BASE_URL=http://localhost:8000/api

# Read-only Lattice API key (starts with lat_). Created in Lattice under the organization's API keys.
LATTICE_API_KEY=lat_replace_me

# Optional: slug of the Event content type. Leave unset to auto-detect (needs Lattice delivery discovery routes).
# LATTICE_EVENT_CONTENT_TYPE=event

# Optional. Which Lattice fields play each calendar role, as JSON. Override only what differs.
# Roles: title, start, end, description, location, category. Defaults: title, start_time, end_time, description, location, category.
# LATTICE_FIELD_MAP={"title":"name","start":"starts_at","end":"ends_at"}

# Port for the Node server (API + built UI).
PORT=3002

# How long /api/events may serve a cached Lattice response, in seconds.
EVENTS_CACHE_TTL_SECONDS=30
